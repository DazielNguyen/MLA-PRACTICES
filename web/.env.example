# Copy to .env.local. Both values below are public browser configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# A legacy anon key is supported instead of a publishable key:
# VITE_SUPABASE_ANON_KEY=
# Never place a secret key or service_role key in any VITE_ variable.
