# Copy to .env.local. Both values below are public browser configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# A legacy anon key is supported instead of a publishable key:
# VITE_SUPABASE_ANON_KEY=
# Never place a secret key or service_role key in any VITE_ variable.

# AI tutor: private server configuration. Never prefix these with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# Use the generated value in your .env.local, or create a random code (at least 16 characters).
AI_CHAT_ACCESS_CODE=REPLACE_WITH_A_LONG_RANDOM_CODE
